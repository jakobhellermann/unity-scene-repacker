<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <RootNamespace>UnitySceneRepacker</RootNamespace>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <!-- packed into the unityscenerepacker package by UnitySceneRepacker.Bindings.csproj -->
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../UnitySceneRepacker.Bindings/UnitySceneRepacker.Bindings.csproj"/>
        <!-- reference assemblies only, the game provides them at runtime -->
        <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" IncludeAssets="compile" PrivateAssets="all"/>
        <!-- generated by `just ci-refs` -->
        <Reference Include="Unity.Addressables" HintPath="../ci-refs/Unity.Addressables.dll" Private="false"/>
        <Reference Include="Unity.ResourceManager" HintPath="../ci-refs/Unity.ResourceManager.dll" Private="false"/>
    </ItemGroup>

</Project>
